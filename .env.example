# MetaTrader 5 credentials
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo

# Trading configuration
# Forex + Metals + Indices
# USDCAD removed: backtests showed it consistently losing across all
# confidence thresholds (PF 0.50-0.62, negative return in every test)
# BTCUSD/ETHUSD tested and removed: PF 0.33-0.78, negative return in
# every threshold (model has no edge on crypto with current features)
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,XAUUSD,US100,US30

# Broker note for indices (US100/US30):
# pip_value_per_lot varies by broker. Default is $1/point/lot.
# If your broker uses a different multiplier (e.g. $10/point), adjust
# the pip_value_per_lot in risk/position_sizing.py INSTRUMENT_SPECS.
MAGIC_NUMBER=20240101
LOT_SIZE=0.01

# Risk parameters
MAX_RISK_PER_TRADE=0.02       # 2% of balance per trade
MAX_DAILY_DRAWDOWN=0.06       # 6% max daily loss
MAX_OPEN_POSITIONS=4
MAX_SPREAD_POINTS=30

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_secret_key

# Logging
LOG_LEVEL=INFO
