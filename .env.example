# Copie este arquivo para .env e preencha. NUNCA comite o .env real --
# ele ja esta no .gitignore. So e lido se voce ativar o modo live (ver
# README, secao "Execucao real").
#
# As chaves devem ser SOMENTE DE NEGOCIACAO (spot trading), sem permissao
# de saque (withdrawal) nem de transferencia. O bot tenta verificar isso
# automaticamente para Binance ao iniciar em modo live e recusa subir se
# detectar permissao de saque habilitada.

BINANCE_API_KEY=
BINANCE_API_SECRET=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Portao 3 do modo live: precisa ser exatamente esta string.
# ARBITRAGE_BOT_LIVE_CONFIRM=I_UNDERSTAND_THE_RISK
